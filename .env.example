# stablepass-web — environment variables
#
# NAMES ONLY. Never commit a real key, secret or price id to this file
# (.rx/guardrails.md #9). Copy to `.env.local` and fill in, or pull the real
# values with `vercel env pull .env.local`.

# --- Supabase -----------------------------------------------------------------

# Supabase project URL. Inlined into the client bundle by `createBrowserClient`
# (`lib/supabase/client.ts`). See .rx/guardrails.md #1 — the anon key plus RLS is
# the security boundary, not the secrecy of this URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. The only Supabase credential allowed to reach client JS;
# the security boundary is RLS, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. NEVER referenced by app or component code — it exists only
# so the Playwright specs in `e2e/` can seed fixtures against a LOCAL Supabase,
# and those specs already default to the well-known local demo key. Leave unset:
# never point this at a hosted project's service-role key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -------------------------------------------------------------------

# Stripe secret key, server-only. Unset is a designed degradation, not a crash:
# /api/subscription/checkout returns 502 `stripe_unavailable`.
STRIPE_SECRET_KEY=

# Stripe publishable key. The only Stripe material that may cross to the browser
# (.rx/guardrails.md #4) — the card is confirmed client-side with Stripe Elements.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Legacy single price id, still read by /api/subscription/checkout. Keep it set:
# ENG-1001 (P3) removes the last read of it, and deleting it before that ships
# is a 502 on every checkout.
STRIPE_PRICE_ID=

# Recurring monthly AUD price for the A$9.00 promo — charged while the member
# still has promo passes left. GST-inclusive; the amount lives in Stripe, never
# in code.
STRIPE_PRICE_ID_PROMO=

# Recurring monthly AUD price for the A$19.00 standard rate — charged once the
# promo allowance is exhausted. GST-inclusive; the amount lives in Stripe, never
# in code.
STRIPE_PRICE_ID_STANDARD=

# Stripe webhook signing secret. NOT read by this app and NOT needed on this
# Vercel project — it is consumed by the `stripe-webhook` Supabase edge function
# in `stablepass-be`, where it must match the signing secret of the registered
# endpoint. Listed here only so the full Stripe surface is discoverable from one
# place; do not mirror it into this project's env.
STRIPE_WEBHOOK_SECRET=

# --- Hosts --------------------------------------------------------------------
#
# Both are read by `lib/hosts.ts` (and reached from `app/robots.ts` via
# `spaceForHost`); the defaults are already correct for production, so a
# deployment that never sets them still works. TRAP: these are `NEXT_PUBLIC_*`
# and therefore inlined at BUILD time — changing one needs a REBUILD, not just
# an env redeploy.

# Host that serves the member app. Defaults to app.stablepass.co.
NEXT_PUBLIC_APP_HOST=

# Host that serves the marketing site. Defaults to stablepass.co.
NEXT_PUBLIC_MARKETING_HOST=
